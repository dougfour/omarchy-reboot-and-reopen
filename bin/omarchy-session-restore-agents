#!/bin/bash

# omarchy:summary=Resume AI agents in herdr panes after a session restore
# omarchy:args=[--dry-run]
# omarchy:hidden=true

set -uo pipefail

STATE_DIR="$HOME/.local/state/omarchy"
AGENTS="$STATE_DIR/herdr-agents.json"
[[ -f $AGENTS ]] || exit 0
command -v herdr &>/dev/null || exit 0
LOG="$STATE_DIR/session-restore.log"

log() {
  printf '%s agents: %s\n' "$(date --iso-8601=seconds)" "$*" >>"$LOG"
}

dry_run=false
[[ ${1:-} == --dry-run ]] && dry_run=true

$dry_run || log "started ($(jq 'length' "$AGENTS") agent(s))"

# Wait for the herdr server. The relaunched client window starts it.
panes=""
for _ in $(seq 45); do
  if panes=$(herdr pane list 2>/dev/null) &&
    [[ $(jq '.result.panes | length' <<<"$panes" 2>/dev/null || echo 0) -gt 0 ]]; then
    break
  fi
  panes=""
  sleep 2
done

if [[ -z $panes ]]; then
  $dry_run || log "skipped because herdr did not become ready"
  $dry_run || mv "$AGENTS" "$AGENTS.skipped"
  exit 0
fi

sleep 3 # let the restored panes settle at their shell prompts

while IFS= read -r saved; do
  kind=$(jq -r '.agent' <<<"$saved")
  saved_pane=$(jq -r '.pane_id' <<<"$saved")
  cwd=$(jq -r '.cwd' <<<"$saved")

  # Prefer the same pane id. Fall back to an agent-free pane with the same cwd.
  target=$(jq -r --arg p "$saved_pane" \
    '.result.panes[] | select(.pane_id == $p and (has("agent") | not)) | .pane_id' <<<"$panes" | head -1)
  if [[ -z $target ]]; then
    target=$(jq -r --arg c "$cwd" \
      '.result.panes[] | select(.cwd == $c and (has("agent") | not)) | .pane_id' <<<"$panes" | head -1)
  fi
  # A restored herdr session comes up with a single pane, so the second and
  # later saved agents have nowhere to land. Make a tab rather than drop them.
  if [[ -z $target ]]; then
    if $dry_run; then
      echo "herdr tab create${cwd:+ --cwd $cwd}   # then resume $kind in its root pane"
      target="(new pane)"
    else
      create_args=(tab create)
      [[ -n $cwd ]] && create_args+=(--cwd "$cwd")
      if created=$(herdr "${create_args[@]}" 2>/dev/null); then
        target=$(jq -r '.result.root_pane.pane_id // empty' <<<"$created")
        [[ -n $target ]] && log "created pane $target for $kind in $cwd"
      fi
    fi
  fi

  if [[ -z $target ]]; then
    $dry_run || log "no free pane for $kind in $cwd"
    notify-send "Session restore" "No free herdr pane found to resume $kind in $cwd" 2>/dev/null
    continue
  fi

  # A real run refreshes the pane list after each agent starts; the preview
  # has to drop the pane itself or it shows every agent landing in the same one.
  if $dry_run && [[ $target != "(new pane)" ]]; then
    panes=$(jq --arg t "$target" '.result.panes |= map(select(.pane_id != $t))' <<<"$panes")
  fi

  # Only claude gets a resume flag; other agent kinds start fresh
  args=()
  [[ $kind == claude ]] && args=(--continue)

  if $dry_run; then
    echo "herdr agent start $kind --kind $kind --pane $target --timeout 60000 -- ${args[*]:-}"
  else
    if herdr agent start "$kind" --kind "$kind" --pane "$target" --timeout 60000 -- "${args[@]}" >/dev/null 2>&1; then
      log "resumed $kind in pane $target"
    else
      log "failed to resume $kind in pane $target"
      notify-send "Session restore" "Could not resume $kind in herdr pane $target" 2>/dev/null
    fi
    panes=$(herdr pane list 2>/dev/null) || break # refresh so the next agent picks a different pane
  fi
done < <(jq -c '.[]' "$AGENTS")

$dry_run || mv "$AGENTS" "$AGENTS.restored"
$dry_run || log "completed"
