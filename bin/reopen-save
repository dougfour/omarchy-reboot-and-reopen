#!/bin/bash

# omarchy:summary=Save open windows and their workspaces for restore on next boot
# omarchy:args=[--quiet]

set -euo pipefail

STATE_DIR="$HOME/.local/state/omarchy"
MANIFEST="$STATE_DIR/session.json"
BOOT_STAMP="$STATE_DIR/session.boot"
mkdir -p "$STATE_DIR"
LOG="$STATE_DIR/session-restore.log"

log() {
  printf '%s save: %s\n' "$(date --iso-8601=seconds)" "$*" >>"$LOG"
}

log "started"

TERMINAL_CLASSES=(Alacritty kitty foot com.mitchellh.ghostty org.wezfurlong.wezterm)
# steam: the window belongs to the steamwebhelper subprocess, so /proc gives a
# relative ./steamwebhelper path and a -steampid from the boot that is ending.
# Nothing usable to relaunch; Steam's own autostart handles it.
SKIP_CLASSES=(walker steam)

is_in() {
  local x=$1 i
  shift
  for i in "$@"; do [[ $i == "$x" ]] && return 0; done
  return 1
}

# herdr runs as a TUI inside a terminal and has no window of its own, so the
# only trace of it is a client process under the terminal's pid.
terminal_runs_herdr() {
  local root=$1 p ppid
  for p in $(pgrep -x herdr 2>/dev/null || true); do
    ppid=$p
    while [[ -n $ppid ]] && ((ppid > 1)); do
      [[ $ppid == "$root" ]] && return 0
      ppid=$(awk '/^PPid:/{print $2}' "/proc/$ppid/status" 2>/dev/null) || break
    done
  done
  return 1
}

entries=()
seen_pids=" "
herdr_ws=0

while IFS= read -r client; do
  class=$(jq -r '.class' <<<"$client")
  ws=$(jq -r '.workspace.id' <<<"$client")
  floating=$(jq -r '.floating' <<<"$client")
  pid=$(jq -r '.pid' <<<"$client")

  ((ws > 0)) || continue # skip special workspaces (scratchpads)
  ((pid > 0)) || continue
  is_in "$class" "${SKIP_CLASSES[@]}" && continue
  [[ -r /proc/$pid/cmdline ]] || continue

  # Windows sharing a process (e.g. multiple Chromium windows) can only be
  # relaunched once, so keep the first occurrence only.
  [[ $seen_pids == *" $pid "* ]] && continue
  seen_pids+="$pid "

  # Rebuild a shell-safe launch command from the process's original argv
  args=()
  while IFS= read -r -d '' arg; do
    args+=("$arg")
  done <"/proc/$pid/cmdline"
  ((${#args[@]} > 0)) || continue

  # Chrome rewrites its own argv, so /proc reports a single element holding
  # the whole command line. Quoting that blob turns it into one impossible
  # argument ("Path ... does not exist"), so split it back into words when
  # the blob is not itself a path and its first token is the executable.
  if ((${#args[@]} == 1)) && [[ ${args[0]} == *" "* && ! -x ${args[0]} ]]; then
    first=${args[0]%% *}
    [[ -x $first ]] && read -r -a args <<<"${args[0]}"
  fi

  cmd=""
  for arg in "${args[@]}"; do
    cmd+="$(printf '%q' "$arg") "
  done
  cmd=${cmd% }
  [[ -n $cmd ]] || continue

  # For terminals, record the shell's working directory so it can be restored
  cwd=""
  if is_in "$class" "${TERMINAL_CLASSES[@]}"; then
    ((herdr_ws > 0)) || ! terminal_runs_herdr "$pid" || herdr_ws=$ws
    shell_pid=$(pgrep -P "$pid" 2>/dev/null | tail -n1 || true)
    if [[ -n ${shell_pid:-} ]]; then
      dir=$(readlink -f "/proc/$shell_pid/cwd" 2>/dev/null || true)
      [[ -d $dir ]] && cwd=$dir
    fi
  fi

  entries+=("$(jq -n \
    --arg class "$class" \
    --argjson workspace "$ws" \
    --argjson floating "$floating" \
    --arg cmd "$cmd" \
    --arg cwd "$cwd" \
    '{class: $class, workspace: $workspace, floating: $floating, cmd: $cmd, cwd: $cwd}')")
done < <(hyprctl clients -j | jq -c '.[]')

# Restoring the terminal alone only brings back a shell prompt: herdr never
# starts, its server never comes up, and the agent resume below finds nothing
# to attach to. Add one entry that launches it the way SUPER CTRL + RETURN
# does. herdr restores its own panes and their directories, so no cwd.
if ((herdr_ws > 0)) && command -v omarchy-launch-terminal-herdr &>/dev/null; then
  entries+=("$(jq -n \
    --arg class "herdr" \
    --argjson workspace "$herdr_ws" \
    --argjson floating false \
    --arg cmd "omarchy-launch-terminal-herdr" \
    --arg cwd "" \
    '{class: $class, workspace: $workspace, floating: $floating, cmd: $cmd, cwd: $cwd}')")
fi

if ((${#entries[@]} == 0)); then
  rm -f "$MANIFEST" "$BOOT_STAMP"
  log "no windows found"
  [[ ${1:-} == --quiet ]] || echo "No windows to save"
  exit 0
fi

printf '%s\n' "${entries[@]}" | jq -s '.' >"$MANIFEST"

# Stamp the boot this manifest belongs to. reopen-restore refuses to
# replay a manifest inside the same boot, so a manual save followed by a shell
# restart cannot relaunch windows that are still open.
cat /proc/sys/kernel/random/boot_id >"$BOOT_STAMP" 2>/dev/null || rm -f "$BOOT_STAMP"

# Snapshot herdr agent panes so reopen-restore-agents can resume them
AGENTS="$STATE_DIR/herdr-agents.json"
agent_count=0
rm -f "$AGENTS"
if command -v herdr &>/dev/null; then
  if agents_json=$(herdr agent list 2>/dev/null) &&
    [[ $(jq '.result.agents | length' <<<"$agents_json" 2>/dev/null || echo 0) -gt 0 ]]; then
    jq '[.result.agents[] | {agent, pane_id, cwd}]' <<<"$agents_json" >"$AGENTS"
    agent_count=$(jq 'length' "$AGENTS")
  fi
fi

log "saved ${#entries[@]} window(s) and $agent_count agent(s)"
[[ ${1:-} == --quiet ]] || echo "Saved ${#entries[@]} window(s) to $MANIFEST"
