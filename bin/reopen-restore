#!/bin/bash

# omarchy:summary=Relaunch windows saved by reopen-save onto their workspaces
# omarchy:args=[--dry-run]

set -euo pipefail

SCRIPT_DIR=$(dirname "$(realpath "$0")")
MANIFEST="$HOME/.local/state/omarchy/session.json"
BOOT_STAMP="${MANIFEST%.json}.boot"
mkdir -p "$(dirname "$MANIFEST")"
LOG="${MANIFEST%.json}-restore.log"

log() {
  printf '%s restore: %s\n' "$(date --iso-8601=seconds)" "$*" >>"$LOG"
}

# Only one restore may run at a time: the shell plugin service and the
# post-boot hook can both fire around login.
exec 9>"${MANIFEST%.json}.lock"
flock -n 9 || exit 0

[[ -f $MANIFEST ]] || exit 0

dry_run=false
[[ ${1:-} == --dry-run ]] && dry_run=true

# A manifest stamped with the running boot was saved without a reboot in
# between, so its windows are still on screen. Replaying it would duplicate
# every one of them. Manifests with no stamp predate this guard and restore
# as before.
current_boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
saved_boot=$(cat "$BOOT_STAMP" 2>/dev/null || true)
if [[ -n $current_boot && $saved_boot == "$current_boot" ]]; then
  if $dry_run; then
    echo "# note: saved in the running boot — a real restore would skip this manifest"
  else
    log "skipped: manifest saved in the running boot, no reboot since"
    exit 0
  fi
fi

$dry_run || log "started ($(jq 'length' "$MANIFEST") window(s))"

# A workspace rule on an exec only binds windows made by the process Hyprland
# spawned. An app that is already running -- every webapp after the browser is
# up, since they all live in the browser process -- creates its window itself,
# the rule never matches, and it lands on whatever workspace is active. Note
# what was already on screen and what each launch was aiming for, then put the
# strays right once everything has appeared.
targets=()
pre_addrs=" $(hyprctl clients -j 2>/dev/null | jq -r '.[].address' | tr '\n' ' ')"

launcher=""
command -v uwsm-app &>/dev/null && launcher="uwsm-app -- "

while IFS= read -r entry; do
  ws=$(jq -r '.workspace' <<<"$entry")
  class=$(jq -r '.class' <<<"$entry")
  cmd=$(jq -r '.cmd' <<<"$entry")
  cwd=$(jq -r '.cwd' <<<"$entry")
  floating=$(jq -r '.floating' <<<"$entry")

  # Terminals: start in the saved working directory
  if [[ -n $cwd ]]; then
    cmd="sh -c $(printf '%q' "cd $(printf '%q' "$cwd") && exec $cmd")"
  fi

  rules="workspace $ws silent"
  [[ $floating == true ]] && rules+="; float"
  exec_arg="[$rules] ${launcher}${cmd}"

  # Hyprland 0.56+ evaluates dispatches as Lua, so issue the exec through
  # hl.dsp.exec_cmd with a long-bracket string that needs no escaping.
  level="="
  while [[ $exec_arg == *"]${level}]"* ]]; do level+="="; done
  lua="hl.dispatch(hl.dsp.exec_cmd([${level}[${exec_arg}]${level}]))"

  if $dry_run; then
    echo "hyprctl eval '$lua'"
  else
    # hyprctl exits 0 even when the Lua it was handed fails, so the only
    # signal is the "error:" line it prints. A bad entry is logged and
    # skipped rather than stranding the rest of the session.
    out=$(hyprctl eval "$lua" 2>&1) || true
    if [[ $out == error:* ]]; then
      log "failed to launch $class on workspace $ws: ${out#error: }"
    else
      log "launched $class on workspace $ws"
      targets+=("$ws $class")
    fi
    sleep 0.2 # stagger launches so the compositor applies each workspace rule cleanly
  fi
done < <(jq -c '.[]' "$MANIFEST")

# Put right anything the workspace rule could not bind. Only windows that were
# not on screen before the restore are touched, and each is claimed once, so a
# class with two entries fills both of its workspaces instead of stacking.
if ! $dry_run && ((${#targets[@]} > 0)); then
  settle=0
  prev_count=-1
  while ((settle < 20)); do
    count=$(hyprctl clients -j 2>/dev/null | jq 'length')
    [[ $count == "$prev_count" ]] && break
    prev_count=$count
    settle=$((settle + 1))
    sleep 0.5
  done

  orig_ws=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id')

  claimed=" "
  for target in "${targets[@]}"; do
    want=${target%% *}
    class=${target#* }

    # Already where it belongs? Claim it and leave it alone.
    addr=$(hyprctl clients -j 2>/dev/null | jq -r --arg c "$class" --argjson w "$want" \
      '[.[] | select(.class == $c and .workspace.id == $w)] | .[].address' |
      while read -r a; do
        [[ $pre_addrs == *" $a "* || $claimed == *" $a "* ]] && continue
        echo "$a"; break
      done)
    if [[ -n $addr ]]; then
      claimed+="$addr "
      continue
    fi

    # Otherwise find a stray of this class and move it.
    addr=$(hyprctl clients -j 2>/dev/null | jq -r --arg c "$class" \
      '[.[] | select(.class == $c and .workspace.id > 0)] | .[].address' |
      while read -r a; do
        [[ $pre_addrs == *" $a "* || $claimed == *" $a "* ]] && continue
        echo "$a"; break
      done)
    [[ -n $addr ]] || continue
    claimed+="$addr "

    hyprctl eval "hl.dispatch(hl.dsp.focus({ window = [=[address:$addr]=] }))" >/dev/null 2>&1
    hyprctl eval "hl.dispatch(hl.dsp.window.move({ workspace = [=[$want]=], follow = false }))" >/dev/null 2>&1
    log "moved $class to workspace $want (the exec rule did not bind it)"
  done

  # Focusing a stray can pull the view to another workspace, so go back to the
  # one that was showing before any of this started.
  [[ -n $orig_ws ]] &&
    hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = [=[$orig_ws]=] }))" >/dev/null 2>&1
fi

# Consume the manifest so the next boot doesn't relaunch everything again
$dry_run || mv "$MANIFEST" "$MANIFEST.restored"
$dry_run || rm -f "$BOOT_STAMP"
$dry_run || log "completed"

# Resume AI agents inside herdr once its relaunched window brings the server up
if [[ -f $HOME/.local/state/omarchy/herdr-agents.json ]]; then
  if $dry_run; then
    "$SCRIPT_DIR/reopen-restore-agents" --dry-run
  else
    setsid -f "$SCRIPT_DIR/reopen-restore-agents" >/dev/null 2>&1
  fi
fi
